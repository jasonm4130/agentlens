{
  "name": "@agentlens/core",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/agentlens.mjs",
  "types": "./dist/agentlens.d.ts",
  "exports": {
    ".": {
      "types": "./dist/agentlens.d.ts",
      "default": "./dist/agentlens.mjs"
    },
    "./scorer": {
      "types": "./dist/scorer.d.ts",
      "default": "./dist/scorer.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "size": "size-limit",
    "check-exports": "publint && rm -rf .pack && pnpm pack --pack-destination .pack >/dev/null && attw --profile esm-only .pack/*.tgz"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@size-limit/file": "catalog:",
    "happy-dom": "catalog:",
    "publint": "catalog:",
    "size-limit": "catalog:",
    "tsdown": "catalog:",
    "vitest": "catalog:"
  }
}
